{
  "name": "mitigator",
  "version": "1.0.0",
  "description": "A production-grade, security-first TypeScript library for Node.js. Defends against XSS, Prototype Pollution, Path Traversal, SQL/NoSQL Injection, and more. Includes adaptive rate limiting, WebAuthn/Passkeys, AES-256-GCM sessions, and post-quantum cryptography (WOTS).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "mitigator-audit": "./dist/bin/mitigator-audit.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "security",
    "xss",
    "sanitize",
    "rate-limit",
    "csrf",
    "jwt",
    "webauthn",
    "passkey",
    "prototype-pollution",
    "path-traversal",
    "injection",
    "crypto",
    "aes-gcm",
    "shamir-secret-sharing",
    "post-quantum",
    "wots",
    "typescript",
    "node"
  ],
  "author": "Mohamed Soliman",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^25.6.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tslib": "^2.8.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "sanitize-html": "^2.17.4"
  }
}
