{
  "name": "mitigator",
  "version": "1.1.1",
  "description": "A production-grade, security-first TypeScript library for Node.js. Defends against XSS, Prototype Pollution, Path Traversal, SQL/NoSQL Injection, and more. Includes adaptive rate limiting, WebAuthn/Passkeys, AES-256-GCM sessions, and post-quantum cryptography (WOTS).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js",
      "require": "./dist/crypto/index.cjs"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js",
      "require": "./dist/fs/index.cjs"
    },
    "./headers": {
      "types": "./dist/headers/index.d.ts",
      "import": "./dist/headers/index.js",
      "require": "./dist/headers/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/index.d.ts",
      "import": "./dist/rate-limit/index.js",
      "require": "./dist/rate-limit/index.cjs"
    },
    "./safe-json": {
      "types": "./dist/safe-json/index.d.ts",
      "import": "./dist/safe-json/index.js",
      "require": "./dist/safe-json/index.cjs"
    },
    "./safe-merge": {
      "types": "./dist/safe-merge/index.d.ts",
      "import": "./dist/safe-merge/index.js",
      "require": "./dist/safe-merge/index.cjs"
    },
    "./sanitize": {
      "types": "./dist/sanitize/index.d.ts",
      "import": "./dist/sanitize/index.js",
      "require": "./dist/sanitize/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./presets": {
      "types": "./dist/utils/presets.d.ts",
      "import": "./dist/utils/presets.js",
      "require": "./dist/utils/presets.cjs"
    },
    "./telemetry": {
      "types": "./dist/utils/telemetry.d.ts",
      "import": "./dist/utils/telemetry.js",
      "require": "./dist/utils/telemetry.cjs"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "import": "./dist/validate/index.js",
      "require": "./dist/validate/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "mitigator-audit": "dist/bin/mitigator-audit.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "watch": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "security",
    "xss",
    "sanitize",
    "rate-limit",
    "csrf",
    "jwt",
    "webauthn",
    "passkey",
    "prototype-pollution",
    "path-traversal",
    "injection",
    "crypto",
    "aes-gcm",
    "shamir-secret-sharing",
    "post-quantum",
    "wots",
    "typescript",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedSoliman21/mitigator.git"
  },
  "bugs": {
    "url": "https://github.com/MohamedSoliman21/mitigator/issues"
  },
  "homepage": "https://github.com/MohamedSoliman21/mitigator#readme",
  "author": "Mohamed Soliman",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^25.6.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tslib": "^2.8.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "sanitize-html": "^2.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "esbuild": "^0.28.2"
  }
}
